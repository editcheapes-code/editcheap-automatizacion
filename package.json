    "format:check": "biome format .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
